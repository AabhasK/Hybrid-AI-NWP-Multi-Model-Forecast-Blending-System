# Blend Desk - credentials
#
# Copy this file to `.env` and fill in whatever you have. EVERY KEY IS
# OPTIONAL: with none of them set the whole pipeline still runs and the
# dashboard still works. Each key upgrades one specific thing.
#
#   cp .env.example .env
#   python config.py        # prints what is active and what each key buys
#
# `.env` is gitignored. Never commit real keys.


# --------------------------------------------------------------------------
# MAPBOX_TOKEN  -  basemap and 3D terrain in the dashboard
# --------------------------------------------------------------------------
# Get a PUBLIC token (starts "pk.") from:
#   https://account.mapbox.com/access-tokens/
# Free tier is 50,000 map loads/month, far beyond a demo.
#
# The token ends up embedded in dashboard.html, so restrict it by URL in the
# Mapbox dashboard (add localhost and your domain) before you ship anything.
#
# Without it: the map falls back to MapLibre GL with OpenFreeMap vector tiles
# and free AWS terrain DEM. Keyless, and visually close.
MAPBOX_TOKEN=your_mapbox_public_token_here


# --------------------------------------------------------------------------
# OPENMETEO_API_KEY  -  higher rate limit on the forecast archive
# --------------------------------------------------------------------------
#   https://open-meteo.com/en/pricing
#
# This is the one that would most help the model. The free tier is capped by
# weighted calls per hour, and pulling five models x five lead times x 121
# cells over a full year exceeds it - the fetcher handles this by waiting for
# the hourly reset and resuming, but a key removes the wait and lets us train
# on a year instead of six months.
#
# Non-commercial use is free WITHOUT a key; this only raises limits.
OPENMETEO_API_KEY=


# --------------------------------------------------------------------------
# CDS_API_KEY  -  ERA5 direct from Copernicus
# --------------------------------------------------------------------------
#   https://cds.climate.copernicus.eu/profile
#
# Only worth setting if a judge specifically asks for a first-party ERA5
# route. The mirror we use serves the same ECMWF ERA5 product with no key and
# no queue; CDS requests can sit in a queue for hours.
CDS_API_KEY=


# --------------------------------------------------------------------------
# IMD_API_KEY  -  India Meteorological Department
# --------------------------------------------------------------------------
# IMD's portal normally issues ONE key covering all endpoints. Four of them
# matter for this project, in priority order:
#
#   1. State District Rainfall Forecast (5 Days)
#      An Indian operational forecast at exactly our T+1..T+5 lead times, so
#      it becomes a SIXTH BLEND MEMBER and the only Indian source in the mix.
#      For an MoES/NCMRWF submission this is the strongest single addition.
#
#   2. AWS/ARG Data
#      Automatic Weather Station / rain-gauge observations - real ground
#      truth. Verifying against gauges instead of ERA5 removes the one
#      methodological weakness disclosed in DATA_NOTE.md (ECMWF AIFS is
#      trained on ERA5, so scoring it against ERA5 flatters it).
#
#   3. District-wise Rainfall
#      Observed rainfall by district. Easier to join than raw stations, so
#      the practical fallback for (2).
#
#   4. District-wise Warnings
#      IMD's official colour-coded warnings, which lets us score our extreme
#      flagger against what IMD actually issued rather than against a
#      threshold we chose ourselves.
#
#   Bonus: "City Weather Forecast with Latitude & Longitude" hits our grid
#   cells directly with no district-to-grid spatial join, and likely carries
#   temperature and wind as well.
#
#   Not needed: subdivision products (36 units is too coarse for a weight
#   map), marine/cyclone/astronomical (outside this problem statement), and
#   nowcasts (0-3 h is the wrong timescale for medium-range blending).
#
# NOTE: IMD products are keyed by district/subdivision POLYGONS, not a
# lat/lon grid, so ingesting them needs a district-to-cell spatial join.
# Endpoints (all confirmed live, all returning "API key missing" unauthenticated):
#   /state_district_rainfall_forecast   5-day district forecast  -> blend member
#   /aws_data , /aws_data_mapping       station observations     -> gauge truth
#   /districtrainfall                   observed district rain   -> gauge truth
#   /districtwarning                    official colour warnings -> flagger check
# `python imd_client.py` prints live status once a key is present.
IMD_API_KEY=
IMD_API_BASE=https://api.imd.gov.in/api/v1
# query | header | bearer - leave blank and the client tries all three
IMD_AUTH_MODE=

# ACCUWEATHER_API_KEY  -  city cross-check column (comparison only, not blended)
#   free tier: 50 calls/day, non-commercial, attribution required
ACCUWEATHER_API_KEY=

# GOOGLE_WEATHER_API_KEY  -  city cross-check column (comparison only, not blended)
#   free tier: 10,000 calls/month
GOOGLE_WEATHER_API_KEY=
